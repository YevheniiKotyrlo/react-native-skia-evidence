+  // Contribution 539's probe (not upstream): what the calling thread's
+  // recorders hold, once they took back what came back to them.
+  static std::pair<size_t, size_t> threadRecorderBytes() {
+    size_t budgeted = 0;
+    size_t purgeable = 0;
+    for (auto *slot : {&threadSlot(), &uploadSlot()}) {
+      if (slot->recorder != nullptr) {
+        slot->recorder->performDeferredCleanup(std::chrono::hours(24));
+        budgeted += slot->recorder->currentBudgetedBytes();
+        purgeable += slot->recorder->currentPurgeableBytes();
+      }
+    }
+    return {budgeted, purgeable};
+  }
+
