index 000000000..abfaa56be
--- /dev/null
+++ b/packages/skia/src/renderer/__tests__/e2e/FirstPixel.probe.spec.tsx
@@ -0,0 +1,43 @@
+import { itRunsE2eOnly } from "../../../__tests__/setup";
+import { surface, wait } from "../setup";
+
+interface FirstPixelReport {
+  done: boolean;
+  results: unknown;
+  error: string | null;
+}
+
+const readReport = async () =>
+  JSON.parse(
+    await surface.eval(() => {
+      const state = globalThis as {
+        __firstPixel?: unknown;
+        __firstPixelDone?: boolean;
+        __firstPixelError?: string;
+      };
+      return JSON.stringify({
+        done: state.__firstPixelDone === true,
+        results: state.__firstPixel ?? null,
+        error: state.__firstPixelError ?? null,
+      });
+    }, {})
+  ) as FirstPixelReport;
+
+describe("Time to first pixel, per presenter (probe)", () => {
+  itRunsE2eOnly(
+    "reports the samples of every presenter and size",
+    async () => {
+      await surface.screen("FirstPixel");
+      // The trials outlast one message of the harness: their end is polled.
+      let report = await readReport();
+      while (!report.done) {
+        await wait(1000);
+        report = await readReport();
+      }
+      console.log(`FIRST_PIXEL ${JSON.stringify(report.results)}`);
+      expect(report.error).toBeNull();
+      expect(report.results).not.toBeNull();
+    },
+    300000
+  );
+});
