diff --git a/packages/skia/src/renderer/__tests__/e2e/Background.probe.spec.tsx b/packages/skia/src/renderer/__tests__/e2e/Background.probe.spec.tsx
new file mode 100644
index 000000000..da9c36a27
--- /dev/null
+++ b/packages/skia/src/renderer/__tests__/e2e/Background.probe.spec.tsx
@@ -0,0 +1,129 @@
+import { execFileSync } from "child_process";
+
+import { itRunsE2eOnly } from "../../../__tests__/setup";
+import { readScreenHalves, surface, wait } from "../setup";
+
+type Waited = "reached" | "timed-out";
+
+// Android: run-e2e.sh exports the device it holds.
+const serial = process.env.ANDROID_SERIAL ?? "";
+
+const adb = (...args: string[]) =>
+  execFileSync("adb", ["-s", serial, ...args], {
+    encoding: "utf8",
+    windowsHide: true,
+  });
+
+const resumedActivity = () =>
+  adb("shell", "dumpsys", "activity", "activities")
+    .split("\n")
+    .find(
+      (line) =>
+        line.includes("mResumedActivity") || line.includes("topResumedActivity")
+    ) ?? "";
+
+// The package of the app in front, e.g. "{… com.example/.MainActivity t12}".
+const frontPackage = () => {
+  const match = /\s([\w.]+)\/[\w.]*/.exec(resumedActivity());
+  return match === null ? "" : match[1];
+};
+
+// adb has no event for an activity's state: polled, with a verdict of its own
+// once the attempts run out.
+const waitForFront = async (appPackage: string, inFront: boolean) => {
+  for (let attempt = 0; attempt < 50; attempt++) {
+    if ((frontPackage() === appPackage) === inFront) {
+      return "reached" as Waited;
+    }
+    await new Promise((resolve) => setTimeout(resolve, 100));
+  }
+  return "timed-out" as Waited;
+};
+
+const backgroundAndBackOnAndroid = async () => {
+  const appPackage = frontPackage();
+  expect(appPackage).not.toBe("");
+  adb("shell", "input", "keyevent", "KEYCODE_HOME");
+  expect(await waitForFront(appPackage, false)).toBe("reached");
+  adb(
+    "shell",
+    "monkey",
+    "-p",
+    appPackage,
+    "-c",
+    "android.intent.category.LAUNCHER",
+    "1"
+  );
+  expect(await waitForFront(appPackage, true)).toBe("reached");
+};
+
+// iOS: run-e2e-wifi.zsh exports the device and the app's bundle id.
+const devicectl = (...args: string[]) =>
+  execFileSync("xcrun", ["devicectl", ...args], { encoding: "utf8" });
+
+// The app's AppState changes since it started (FirstPixel.tsx records them).
+const appStates = async () =>
+  JSON.parse(
+    await surface.eval(
+      () =>
+        JSON.stringify(
+          (globalThis as { __appStates?: string[] }).__appStates ?? []
+        ),
+      {}
+    )
+  ) as string[];
+
+// Settings is brought to the front, then the app; the app's own AppState
+// says it went to the background and came back to the same process, as a
+// relaunched app would have no record of the trip.
+const backgroundAndBackOnIOS = async () => {
+  const device = process.env.IOS_DEVICE ?? "";
+  const bundleId = process.env.IOS_BUNDLE_ID ?? "";
+  expect(device).not.toBe("");
+  expect(bundleId).not.toBe("");
+  const before = (await appStates()).length;
+  devicectl(
+    "device",
+    "process",
+    "launch",
+    "--device",
+    device,
+    "com.apple.Preferences"
+  );
+  await wait(3000);
+  devicectl("device", "process", "launch", "--device", device, bundleId);
+  let waited: Waited = "timed-out";
+  for (let attempt = 0; attempt < 50 && waited === "timed-out"; attempt++) {
+    const states = (await appStates()).slice(before);
+    if (
+      states.includes("background") &&
+      states[states.length - 1] === "active"
+    ) {
+      waited = "reached";
+    } else {
+      await wait(200);
+    }
+  }
+  expect(waited).toBe("reached");
+};
+
+const backgroundAndBack = () =>
+  surface.OS === "ios"
+    ? backgroundAndBackOnIOS()
+    : backgroundAndBackOnAndroid();
+
+describe("Static presentation through the background (probe)", () => {
+  itRunsE2eOnly("keeps a static canvas's frame", async () => {
+    const before = readScreenHalves(await surface.screen("StaticCanvas"));
+    await backgroundAndBack();
+    const after = readScreenHalves(await surface.screen("StaticCanvas"));
+    expect(after).toEqual(before);
+  });
+
+  itRunsE2eOnly("keeps an image view's bitmap", async () => {
+    const before = readScreenHalves(await surface.screen("ImageView"));
+    await backgroundAndBack();
+    const after = readScreenHalves(await surface.screen("ImageView"));
+    expect(after).toEqual(before);
+  });
+});
diff --git a/packages/skia/src/renderer/__tests__/e2e/FirstPixel.probe.spec.tsx b/packages/skia/src/renderer/__tests__/e2e/FirstPixel.probe.spec.tsx
