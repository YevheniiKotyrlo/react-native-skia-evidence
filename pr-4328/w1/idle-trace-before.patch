@@ -34,9 +34,28 @@ RNSkThreadPool &renderPool() {
     threads.setIdleTask([](bool idle) {
       // What went away with the request is older than this by the time the
       // task runs, what the views still drawing use is not.
+      RNSkLogger::logToConsole("W1_IDLE_TRIM begin idle=%d", idle ? 1 : 0);
       DawnContext::trimThreadRecorders(RNSkThreadPool::kIdleDelay / 2, idle);
+      RNSkLogger::logToConsole("W1_IDLE_TRIM end idle=%d", idle ? 1 : 0);
       if (idle) {
+        // W1's probe (not upstream): Dawn's pool around the release.
+        auto *probeContext = DawnContext::tryGetInstance();
+        const auto before =
+            probeContext == nullptr
+                ? 0
+                : dawn::native::GetAllocatorMemoryInfo(
+                      probeContext->getWGPUDevice().Get())
+                      .totalAllocatedMemory;
         DawnContext::reduceMemoryUsage();
+        const auto after =
+            probeContext == nullptr
+                ? 0
+                : dawn::native::GetAllocatorMemoryInfo(
+                      probeContext->getWGPUDevice().Get())
+                      .totalAllocatedMemory;
+        RNSkLogger::logToConsole("W1_IDLE_RELEASE allocated %llu -> %llu",
+                                 static_cast<unsigned long long>(before),
+                                 static_cast<unsigned long long>(after));
       }
     });
     ImageProvider::setReleaseListener(
