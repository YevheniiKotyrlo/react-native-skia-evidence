                                      : jsi::Value(runtime, string(gpu.error)));
     result.setProperty(runtime, "lost",
                        getLostPromise(runtime, gpu.generation));
+    // Probe only, not for merging: four render-pool jobs that wait for
+    // each other, so each runs on a thread of its own, log what that thread's
+    // drawing recorder holds; and Dawn's own account of the device's memory.
+    result.setProperty(
+        runtime, "__idleRunCensus",
+        jsi::Function::createFromHostFunction(
+            runtime, jsi::PropNameID::forAscii(runtime, "__idleRunCensus"), 1,
+            [](jsi::Runtime &runtime, const jsi::Value &,
+               const jsi::Value *arguments, size_t count) -> jsi::Value {
+              auto mark = std::make_shared<std::string>(
+                  count > 0 && arguments[0].isString()
+                      ? arguments[0].asString(runtime).utf8(runtime)
+                      : std::string("census"));
+              struct Latch {
+                std::mutex mutex;
+                std::condition_variable condition;
+                int arrived = 0;
+              };
+              auto latch = std::make_shared<Latch>();
+              constexpr int threads = 4;
+              for (int job = 0; job < threads; job++) {
+                RNSkThreadPool::getInstance().post([latch, mark]() {
+                  std::unique_lock<std::mutex> lock(latch->mutex);
+                  latch->arrived++;
+                  latch->condition.notify_all();
+                  latch->condition.wait_for(
+                      lock, std::chrono::milliseconds(500),
+                      [&latch]() { return latch->arrived >= threads; });
+                  lock.unlock();
+                  DawnContext::logThreadRecorder(mark->c_str());
+                });
+              }
+              return jsi::Value::undefined();
+            }));
+    result.setProperty(
+        runtime, "__memory",
+        jsi::Function::createFromHostFunction(
+            runtime, jsi::PropNameID::forAscii(runtime, "__memory"), 0,
+            [](jsi::Runtime &runtime, const jsi::Value &, const jsi::Value *,
+               size_t) -> jsi::Value {
+              auto *context = DawnContext::tryGetInstance();
+              if (context == nullptr) {
+                return jsi::Value::null();
+              }
+              auto device = context->getWGPUDevice();
+              const auto usage =
+                  dawn::native::ComputeEstimatedMemoryUsageInfo(device.Get());
+              const auto allocator =
+                  dawn::native::GetAllocatorMemoryInfo(device.Get());
+              jsi::Object info(runtime);
+              info.setProperty(runtime, "textures",
+                               static_cast<double>(usage.texturesUsage));
+              info.setProperty(runtime, "total",
+                               static_cast<double>(usage.totalUsage));
+              info.setProperty(
+                  runtime, "allocatorUsed",
+                  static_cast<double>(allocator.totalUsedMemory));
+              info.setProperty(
+                  runtime, "allocatorAllocated",
+                  static_cast<double>(allocator.totalAllocatedMemory));
+              return info;
+            }));
     return result;
   }
 
