+import { AppRegistry } from "react-native";
+import "react-native-skia";
+
+import { IdleRunProbe } from "./src/IdleRunProbe";
+import { name as appName } from "./app.json";
+
+if (!Symbol.dispose) {
+  Symbol.dispose = Symbol.for("Symbol.dispose");
+}
+
+AppRegistry.registerComponent(appName, () => IdleRunProbe);
diff --git a/apps/example/src/IdleRunProbe.tsx b/apps/example/src/IdleRunProbe.tsx
new file mode 100644
index 0000000..9acfc71
--- /dev/null
+++ b/apps/example/src/IdleRunProbe.tsx
@@ -0,0 +1,170 @@
+import React, { useEffect, useState } from "react";
+import { StyleSheet, Text as NativeText, View } from "react-native";
+import {
+  Blur,
+  Canvas,
+  Circle,
+  Group,
+  Path,
+  Rect,
+  Skia,
+  Text,
+  matchFont,
+} from "react-native-skia";
+import type { SharedValue } from "react-native-reanimated";
+import {
+  Easing,
+  cancelAnimation,
+  useDerivedValue,
+  useSharedValue,
+  withRepeat,
+  withTiming,
+} from "react-native-reanimated";
+
+// Probe only, not for merging: what each render thread keeps once canvases unmount while another canvas still
+// draws, then stops. Each cycle mounts the content canvases beside a spinning one, unmounts them while it spins on past
+// the idle task's due time (RNSkThreadPool::kIdleDelay, 2 s), stops it, waits past the delay again, and asks every
+// render thread for what its drawing recorder holds (IDLEDIAG census lines, from the probe's native patch).
+
+const contentCanvasCount = 30;
+const canvasSide = 110;
+const cycles = 8;
+const settleMilliseconds = 6000;
+const mountedMilliseconds = 2500;
+const spinAfterUnmountMilliseconds = 3000;
+const afterStopMilliseconds = 4500;
+const censusMilliseconds = 1000;
+
+type ProbeGpu = {
+  __idleRunCensus(mark: string): void;
+  __memory(): {
+    textures: number;
+    total: number;
+    allocatorUsed: number;
+    allocatorAllocated: number;
+  } | null;
+};
+
+const probeGpu = () => Skia.gpu as unknown as ProbeGpu;
+
+const wait = (milliseconds: number) =>
+  new Promise<void>((resolve) => setTimeout(resolve, milliseconds));
+
+const megabytes = (bytes: number) => (bytes / (1024 * 1024)).toFixed(2);
+
+const census = async (mark: string) => {
+  probeGpu().__idleRunCensus(mark);
+  const memory = probeGpu().__memory();
+  if (memory !== null) {
+    console.log(
+      `IDLE memory mark=${mark} textures=${megabytes(memory.textures)} total=${megabytes(memory.total)} ` +
+        `allocatorUsed=${megabytes(memory.allocatorUsed)} allocatorAllocated=${megabytes(memory.allocatorAllocated)}`
+    );
+  }
+  await wait(censusMilliseconds);
+};
+
+const starPath = (index: number) => {
+  const points = 7 + (index % 9);
+  const builder = Skia.PathBuilder.Make();
+  for (let point = 0; point <= points * 2; point++) {
+    const radius = point % 2 === 0 ? canvasSide * 0.42 : canvasSide * 0.18;
+    const angle = (Math.PI * point) / points;
+    const x = canvasSide / 2 + radius * Math.cos(angle);
+    const y = canvasSide / 2 + radius * Math.sin(angle);
+    if (point === 0) {
+      builder.moveTo(x, y);
+    } else {
+      builder.lineTo(x, y);
+    }
+  }
+  builder.close();
+  return builder.build();
+};
+
+// Glyphs of a size and a run of characters of its own, a path of its own and a blurred circle, so every canvas adds
+// atlas entries and scratch textures to the recorder of the thread that draws it.
+const ContentCanvas = ({ index }: { index: number }) => {
+  const font = matchFont({ fontFamily: "sans-serif", fontSize: 9 + (index % 23) });
+  const first = 0x41 + ((index * 7) % 50);
+  const label = Array.from({ length: 12 }, (_, offset) => String.fromCharCode(first + offset)).join("");
+  return (
+    <Canvas style={styles.canvas}>
+      <Rect x={0} y={0} width={canvasSide} height={canvasSide} color={`rgb(${150 + ((index * 37) % 100)}, ${150 + ((index * 53) % 100)}, ${150 + ((index * 71) % 100)})`} />
+      <Circle cx={canvasSide / 2} cy={canvasSide / 2} r={canvasSide * 0.3} color="steelblue">
+        <Blur blur={2 + (index % 6)} />
+      </Circle>
+      <Path path={starPath(index)} color={`rgb(${(index * 83) % 200}, ${(index * 29) % 200}, ${(index * 61) % 200})`} />
+      <Text x={4} y={canvasSide - 8} text={label} font={font} color="black" />
+    </Canvas>
+  );
+};
+
+const SpinningCanvas = ({ progress }: { progress: SharedValue<number> }) => {
+  const transform = useDerivedValue(() => [{ rotate: progress.value * 2 * Math.PI }]);
+  return (
+    <Canvas style={styles.canvas}>
+      <Group origin={{ x: canvasSide / 2, y: canvasSide / 2 }} transform={transform}>
+        <Rect x={canvasSide * 0.2} y={canvasSide * 0.45} width={canvasSide * 0.6} height={canvasSide * 0.1} color="tomato" />
+      </Group>
+    </Canvas>
+  );
+};
+
+export const IdleRunProbe = () => {
+  const [step, setStep] = useState("starting");
+  const [showContent, setShowContent] = useState(false);
+  const progress = useSharedValue(0);
+
+  useEffect(() => {
+    const spin = () => {
+      progress.value = 0;
+      progress.value = withRepeat(withTiming(1, { duration: 1000, easing: Easing.linear }), -1);
+    };
+    const mark = (name: string) => {
+      setStep(name);
+      console.log(`IDLE mark=${name}`);
+    };
+    const run = async () => {
+      await wait(settleMilliseconds);
+      await census("baseline");
+      for (let cycle = 1; cycle <= cycles; cycle++) {
+        mark(`cycle-${cycle}-mount`);
+        spin();
+        setShowContent(true);
+        await wait(mountedMilliseconds);
+        mark(`cycle-${cycle}-unmount`);
+        setShowContent(false);
+        await wait(spinAfterUnmountMilliseconds);
+        mark(`cycle-${cycle}-stop`);
+        cancelAnimation(progress);
+        await wait(afterStopMilliseconds);
+        mark(`cycle-${cycle}-census`);
+        await census(`cycle-${cycle}-end`);
+      }
+      mark("done");
+    };
+    run().catch((error: unknown) => {
+      console.log(`IDLE error ${String(error)}`);
+      setStep(`error: ${String(error)}`);
+    });
+  }, [progress]);
+
+  return (
+    <View style={styles.container}>
+      <NativeText style={styles.step}>{step}</NativeText>
+      <SpinningCanvas progress={progress} />
+      <View style={styles.grid}>
+        {showContent &&
+          Array.from({ length: contentCanvasCount }, (_, index) => <ContentCanvas key={index} index={index} />)}
+      </View>
+    </View>
+  );
+};
+
+const styles = StyleSheet.create({
+  container: { flex: 1, backgroundColor: "white", paddingTop: 32, alignItems: "center" },
+  step: { fontSize: 18, color: "black" },
+  grid: { flexDirection: "row", flexWrap: "wrap", justifyContent: "center" },
+  canvas: { width: canvasSide, height: canvasSide, margin: 2 },
+});
