+  // Evidence probe, not for merging: the bytes the Graphite context
+  // caches, budgeted and purgeable.
+  std::pair<size_t, size_t> probeContextCache() {
+    std::lock_guard<std::mutex> lock(_mutex);
+    auto *current = _current.load(std::memory_order_acquire);
+    return {current->context->currentBudgetedBytes(),
+            current->context->currentPurgeableBytes()};
+  }
