+// A layer made for a view put back in its superview: when it is made, when
+// the run loop turn's Core Animation commit is through, and every vsync.
+static void probeReattach(CAMetalLayer *layer) {
+  void *handle = (__bridge void *)layer;
+  RNSkia::reattachProbeLog("MADE layer=%p t=%.6f", handle,
+                           RNSkia::reattachProbeNow());
+#if !TARGET_OS_OSX
+  static CADisplayLink *displayLink = nil;
+  if (displayLink == nil) {
+    static ReattachProbeTicker *ticker = [ReattachProbeTicker new];
+    displayLink = [CADisplayLink displayLinkWithTarget:ticker
+                                              selector:@selector(tick:)];
+    if (@available(iOS 15.0, *)) {
+      displayLink.preferredFrameRateRange = CAFrameRateRangeMake(120, 120, 120);
+    }
+    [displayLink addToRunLoop:[NSRunLoop mainRunLoop]
+                      forMode:NSRunLoopCommonModes];
+  }
+#endif
+  CFRunLoopObserverRef observer = CFRunLoopObserverCreateWithHandler(
+      kCFAllocatorDefault, kCFRunLoopBeforeWaiting | kCFRunLoopExit, false,
+      INT_MAX, ^(CFRunLoopObserverRef, CFRunLoopActivity) {
+        RNSkia::reattachProbeLog("COMMITTED layer=%p t=%.6f", handle,
+                                 RNSkia::reattachProbeNow());
+      });
+  CFRunLoopAddObserver(CFRunLoopGetMain(), observer, kCFRunLoopCommonModes);
+  CFRelease(observer);
+}
