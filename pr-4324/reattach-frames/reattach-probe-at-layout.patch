@@ -0,0 +1,18 @@
+import { itRunsE2eOnly } from "../../../__tests__/setup";
+import { surface } from "../setup";
+
+// The re-attach probe: views put back in their superview, for the native trace in
+// $TMPDIR/reattach-probe.log.
+describe("A view put back in its superview (probe)", () => {
+  itRunsE2eOnly("comes back from a scroll view's clipping", async () => {
+    for (let trip = 0; trip < 5; trip++) {
+      await surface.screen("ClippedSubviewsBack");
+    }
+  });
+
+  itRunsE2eOnly("moves with a reorder", async () => {
+    for (let trip = 0; trip < 3; trip++) {
+      await surface.screen("ReorderCanvases");
+    }
+  });
+});
