@@ -0,0 +1,34 @@
+import React, { useEffect, useState } from "react";
+import { View } from "react-native";
+import { Canvas, Fill } from "react-native-skia";
+
+import { useScreenDone } from "../ScreenDone";
+
+// The re-attach probe: three keyed canvases whose order flips every 300 ms, which
+// Fabric mounts as a remove and an insert of the same views; done after the
+// last flip.
+const COLORS = ["red", "lime", "blue"];
+const FLIPS = 6;
+
+export const ReorderCanvases = () => {
+  const [flips, setFlips] = useState(0);
+  const done = useScreenDone();
+  useEffect(() => {
+    if (flips >= FLIPS) {
+      done();
+      return;
+    }
+    const timer = setTimeout(() => setFlips((value) => value + 1), 300);
+    return () => clearTimeout(timer);
+  }, [flips, done]);
+  const order = flips % 2 === 0 ? COLORS : [...COLORS].reverse();
+  return (
+    <View style={{ flex: 1, flexDirection: "row" }} collapsable={false}>
+      {order.map((color) => (
+        <Canvas key={color} style={{ flex: 1 }}>
+          <Fill color={color} />
+        </Canvas>
+      ))}
+    </View>
+  );
+};
